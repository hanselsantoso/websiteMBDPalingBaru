# Public configuration. Copy to .env and set the final HTTPS origin before building.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PORT=3000
PMB_MAX_DOCUMENT_MB=2
# Server-only secrets are read from protected files, never committed.
PAYLOAD_SECRET_FILE=.secrets/payload-secret
DATABASE_URL_FILE=.secrets/database-url
MEDIA_DIR=.local-data/media
PMB_DOCUMENTS_DIR=.local-data/pmb-documents
# Configure email securely when a provider is available.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
TURNSTILE_SECRET_KEY=
